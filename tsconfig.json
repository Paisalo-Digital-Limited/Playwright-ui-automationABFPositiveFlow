
{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "typeRoots": ["./types", "./node_modules/@types"],
    "lib": ["esnext", "DOM"],
    "target": "esnext",
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./dist",
    "rootDir": "./",
    "resolveJsonModule": true,
  },
  "include": ["**/*.ts"]
}